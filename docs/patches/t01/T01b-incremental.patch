+        val openWriteUris = mutableListOf<Uri>()
+        val updateUris = mutableListOf<Uri>()
+        val publishUpdateUris = mutableListOf<Uri>()
+        val dateModifiedUpdateUris = mutableListOf<Uri>()
+        val deleteUris = mutableListOf<Uri>()
